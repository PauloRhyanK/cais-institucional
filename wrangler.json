{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cais-institucional",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/planejamento/api/*"
    ]
  },
  "ratelimits": [
    {
      "name": "LIMITE_ENVIOS",
      "namespace_id": "4101",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
